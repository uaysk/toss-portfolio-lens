# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.7.19@sha256:2dcbc74e60ed6d842122ed538f5267c80e7cde4ff1b6e66a199b89972496f033 AS uv

FROM python:3.12.13-slim-trixie@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS gpu-core
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY worker/ai/pyproject.toml worker/ai/uv.lock worker/ai/.python-version ./
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    UV_NO_CACHE=0 uv sync --frozen --no-dev --extra gpu-core --no-install-project

FROM gpu-core AS runtime
ENV \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    CUDA_MODULE_LOADING=LAZY \
    AI_MODEL_CACHE_DIR=/models \
    AI_MODEL_LANE=fincast \
    AI_FINCAST_CONTEXT_BARS=512 \
    AI_FINCAST_RAW_BACKEND=cuda_graph \
    AI_FINCAST_RAW_BATCH_15=48 \
    AI_FINCAST_RAW_BATCH_30=48 \
    AI_FINCAST_RAW_BATCH_60=48 \
    AI_MIN_CONTEXT_BARS=512 \
    AI_MAX_CONTEXT_BARS=512 \
    AI_MICROBATCH_SIZE=4 \
    AI_WEBSOCKET_MAX_IN_FLIGHT=1 \
    AI_WEBSOCKET_HOST=0.0.0.0 \
    AI_WEBSOCKET_PORT=8766 \
    AI_WEBSOCKET_PATH=/ws/scalping-ai/v2 \
    AI_WEBSOCKET_AUTH_TOKEN_FILE=/app/fincast-auth/token \
    AI_DEVICE=cuda \
    AI_ALLOW_CPU_FALLBACK=false \
    AI_EXPECTED_CUDA_CAPABILITY=6.1
WORKDIR /app
RUN groupadd --gid 10001 portfolio \
    && useradd --uid 10001 --gid portfolio --no-create-home portfolio \
    && mkdir -p /app/fincast-auth /models \
    && touch /app/fincast-auth/.volume-owner \
    && chown -R portfolio:portfolio /app/fincast-auth
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    UV_NO_CACHE=0 uv sync --frozen --no-dev --extra fincast --no-install-project
COPY worker/ai/model-manifest.json worker/ai/THIRD_PARTY_NOTICES.md worker/ai/README.md ./
COPY worker/ai/src ./src
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    UV_NO_CACHE=0 uv sync --frozen --no-dev --extra fincast \
    && /app/.venv/bin/python -m compileall -q -f /app/src/portfolio_ai_worker \
    && python -m pip uninstall --yes pip setuptools wheel
ARG APP_GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${APP_GIT_SHA}"
USER portfolio
HEALTHCHECK --interval=30s --timeout=3s --start-period=300s --retries=3 \
  CMD ["/app/.venv/bin/portfolio-ai-worker", "healthcheck"]
ENTRYPOINT ["/app/.venv/bin/portfolio-ai-worker"]
CMD ["serve"]
