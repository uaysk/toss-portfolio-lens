{
  "name": "toss-portfolio-lens",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0 --port ${VITE_PORT:-5173}\" \"RUST_COMPUTE_SOCKET=/tmp/toss-portfolio-lens-compute.sock tsx watch server/index.ts\" \"cargo run --release --locked --manifest-path worker/rust/Cargo.toml -- serve --socket /tmp/toss-portfolio-lens-compute.sock --max-active ${RUST_COMPUTE_POOL_SIZE:-2} --max-connections 34\"",
    "dev:legacy": "EXECUTION_MODE=inline concurrently -k \"vite --host 0.0.0.0 --port ${VITE_PORT:-5173}\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run typecheck:tools && npm test && npm run build && npm run docs:mcp:check",
    "test:mysql": "tsx scripts/verify-mysql-storage.ts",
    "test:postgres": "tsx scripts/verify-postgres-storage.ts",
    "test:worker-queue": "tsx scripts/verify-worker-queue-postgres.ts",
    "test:worker-parity": "tsx scripts/verify-rust-worker.ts",
    "test:backtest-worker-parity": "tsx scripts/verify-rust-worker.ts",
    "test:rust-worker": "tsx scripts/verify-rust-worker.ts",
    "test:technical-uds": "cargo build --manifest-path worker/rust/Cargo.toml --locked && tsx scripts/verify-technical-analysis-uds.ts",
    "test:ai-websocket": "tsx scripts/verify-ai-websocket-roundtrip.ts",
    "test:kis-us-realtime": "tsx scripts/verify-kis-us-realtime.ts",
    "test:kis-us-rest": "tsx scripts/verify-kis-us-rest.ts",
    "test:technical-ui": "node scripts/verify-technical-analysis-ui.mjs",
    "test:scalping-ui": "node scripts/verify-scalping-assistant-ui.mjs",
    "test:simulation-ui": "node scripts/verify-ai-simulation-ui.mjs",
    "test:ui-regression": "node scripts/verify-ui-regression.mjs",
    "test:simulation-live": "node scripts/verify-ai-simulation-live.mjs",
    "test:rust-worker-postgres": "tsx scripts/verify-rust-worker-postgres.ts",
    "test:python-worker": "tsx scripts/verify-python-worker-postgres.ts",
    "benchmark:python-worker": "tsx scripts/benchmark-python-worker.ts",
    "benchmark:rust-ipc": "tsx scripts/benchmark-rust-ipc.ts",
    "benchmark:optimization-load": "tsx scripts/benchmark-optimization-load.ts",
    "qualification:ai:p40": "tsx scripts/run-ai-p40-qualification.ts",
    "qualification:fincast:p40:fp32:3week": "node --import tsx scripts/run-fincast-p40-fp32-3week-qualification.ts",
    "qualification:fincast:p40:fp32:5week": "node --import tsx scripts/run-fincast-p40-fp32-3week-qualification.ts --duration-weeks 5",
    "qualification:chronos2:tools": "node scripts/build-chronos2-qualification-tools.mjs",
    "qualification:chronos2:context:tools": "node scripts/build-chronos2-qualification-tools.mjs",
    "benchmark:cadence-context:start": "scripts/start-cadence-context-3w.sh",
    "benchmark:cadence-context:status": "scripts/status-cadence-context-3w.sh",
    "benchmark:cadence-context:logs": "scripts/logs-cadence-context-3w.sh",
    "benchmark:cadence-context:stop": "scripts/stop-cadence-context-3w.sh",
    "benchmark:cadence-context:resume": "scripts/resume-cadence-context-3w.sh",
    "backtest:simulation:unified": "node scripts/run-unified-simulation-backtests.mjs",
    "backtest:simulation:monitor": "node scripts/monitor-unified-simulation-backtests.mjs",
    "backtest:simulation:high-vol-stacks": "bash scripts/run-high-vol-stack-backtest.sh",
    "backtest:simulation:high-vol-profitability:start": "bash scripts/start-high-vol-stack-profitability.sh",
    "backtest:simulation:high-vol-profitability:status": "bash scripts/status-high-vol-stack-profitability.sh",
    "backtest:simulation:high-vol-profitability:stop": "bash scripts/stop-high-vol-stack-profitability.sh",
    "backtest:simulation:high-vol-profitability:resume": "bash scripts/resume-high-vol-stack-profitability.sh",
    "docs:capture-readme": "node scripts/capture-readme-showcase.mjs",
    "docs:mcp": "tsx scripts/generate-mcp-docs.ts",
    "docs:mcp:check": "tsx scripts/generate-mcp-docs.ts --check",
    "mcp:oauth:bootstrap": "node scripts/generate-mcp-oauth-secrets.mjs",
    "mcp:oauth:smoke": "node scripts/mcp-oauth-http-smoke.mjs",
    "mcp:browser:smoke": "node scripts/mcp-browser-smoke.mjs",
    "verify:harbor-release": "node scripts/verify-harbor-release.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1088.0",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@binance/derivatives-trading-usds-futures": "36.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "5.1.0",
    "jose": "^6.2.3",
    "mysql2": "^3.23.0",
    "pg": "^8.22.0",
    "ws": "8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-slot": "1.2.3",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/pg": "^8.20.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "9.1.2",
    "lucide-react": "0.468.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.4",
    "tailwindcss": "3.4.17",
    "tailwind-merge": "2.6.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  }
}
