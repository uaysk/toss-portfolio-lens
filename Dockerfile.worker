# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.7.19@sha256:2dcbc74e60ed6d842122ed538f5267c80e7cde4ff1b6e66a199b89972496f033 AS uv

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /app
RUN groupadd --gid 10001 portfolio && useradd --uid 10001 --gid portfolio --no-create-home portfolio
COPY worker/python/pyproject.toml worker/python/uv.lock worker/python/.python-version ./
COPY worker/python/src ./src
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    UV_NO_CACHE=0 uv sync --frozen --no-dev \
    && /app/.venv/bin/python -m compileall -q -f /app/src/portfolio_worker \
    && chown -R portfolio:portfolio /app
LABEL org.opencontainers.image.deprecated="true" \
      org.opencontainers.image.deprecation-message="Use Dockerfile.worker.rust; observe one Harbor release plus 14 days before removal."
USER portfolio
ENTRYPOINT ["/app/.venv/bin/portfolio-compute-worker"]
CMD ["run"]
