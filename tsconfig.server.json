{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "declaration": true,
    "incremental": true,
    "outDir": "dist/server",
    "rootDir": "server",
    "tsBuildInfoFile": ".cache/tsbuildinfo/server.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
